* text=auto

# The compiled compendium packs are LevelDB: binary files with no extension to go on, some of them
# named MANIFEST-000002 or 000004.log. Line-ending normalisation would silently corrupt them, and a
# corrupted pack is not obvious until a Talent fails to load in play, so say so explicitly rather
# than trusting git to guess.
foundry/starwrought/packs/** binary

# Authored and generated binaries.
*.docx binary
*.xlsx binary
*.pdf binary
*.png binary
