# Build output. `dist/` is rebuilt by assets/package_system.mjs on every release.
dist/
node_modules/

# Pre-version snapshots. Large, and git already keeps the history.
backup/

# The compiled compendium packs. They are LevelDB databases, and Foundry runs against this very
# folder through the junction that foundry/install.mjs makes, so it rewrites their log and
# manifest files every time a world opens. Committed, they would dirty the tree on every session
# and invite committing a half-written database. The JSON they are compiled from lives in
# packs/_source and is committed; `node assets/build_foundry.mjs` rebuilds them from it, locally
# and in the release workflow.
foundry/starwrought/packs/*
!foundry/starwrought/packs/_source/

# Python, Word and Excel leavings. The ~$ files are Office's open-document locks.
__pycache__/
*.pyc
~$*.docx
~$*.xlsx

# Agent worktrees made by the Claude desktop app
.claude/worktrees/

# Handbook proposals (tracked changes for Mike to accept; not editions)
*_proposal.docx
