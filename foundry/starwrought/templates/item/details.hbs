{{!-- The mechanical fields: one partial per Item type under details/, named for the type, each
     including the shared panels it needs (details/aura.hbs, details/automation.hbs,
     details/physical.hbs). A new Item type is a new file here and a line in preloadTemplates
     (module/helpers/handlebars.mjs); nothing else branches on the type. --}}
<section class="tab sw-tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  {{> (concat "systems/starwrought/templates/item/details/" type ".hbs")}}
</section>
