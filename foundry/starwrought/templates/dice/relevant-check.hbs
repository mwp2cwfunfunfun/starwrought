{{!-- A Relevant Check: the actor names the Constellation and the reason, and the card carries both. --}}
{{!-- A div, not a form: DialogV2 supplies the form, and a nested one is dropped by the parser. --}}
<div class="check-dialog-form sw-relevant">

  <p class="sw-relevant-intro">{{localize "STARWROUGHT.Roll.relevantIntro"}}</p>

  <div class="form-group">
    <label>{{localize "STARWROUGHT.Roll.relevantWhich"}}</label>
    <div class="form-fields">
      <select name="slug" autofocus>
        {{#if trained.length}}
        <optgroup label="{{localize 'STARWROUGHT.Roll.relevantTrained'}}">
          {{#each trained as |c|}}
          <option value="{{c.slug}}">{{c.glyph}} {{c.name}} · {{c.rankLabel}} {{swSigned c.mod}}</option>
          {{/each}}
        </optgroup>
        {{/if}}
        <optgroup label="{{localize 'STARWROUGHT.Roll.relevantUntrained'}}">
          {{#each untrained as |c|}}
          <option value="{{c.slug}}">{{c.glyph}} {{c.name}} · {{c.rankLabel}} {{swSigned c.mod}}</option>
          {{/each}}
        </optgroup>
      </select>
    </div>
  </div>

  <div class="form-group">
    <label>{{localize "STARWROUGHT.Roll.relevantWhy"}}</label>
    <div class="form-fields">
      <input type="text" name="why" placeholder="{{localize 'STARWROUGHT.Roll.relevantWhyPlaceholder'}}">
    </div>
  </div>

  <div class="form-group">
    <label>{{localize "STARWROUGHT.Field.threshold"}}</label>
    <div class="form-fields">
      <input type="number" name="threshold" value="{{threshold}}"
             placeholder="{{localize 'STARWROUGHT.Roll.thresholdPlaceholder'}}">
    </div>
  </div>

  <p class="hint">{{localize "STARWROUGHT.Roll.relevantHint"}}</p>

</div>
