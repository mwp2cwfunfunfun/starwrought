{{!-- Everything you have to decide before the die leaves your hand. --}}
{{!-- A div, not a form: DialogV2 supplies the form, and a nested one is dropped by the parser. --}}
<div class="check-dialog-form">

  <ul class="sw-card-modifiers">
    {{#each parts as |mod|}}
    <li><span>{{mod.label}}</span><strong>{{swSigned mod.value}}</strong></li>
    {{/each}}
    <li class="sw-total"><span>{{localize "STARWROUGHT.Roll.beforeTheDie"}}</span><strong>{{swSigned total}}</strong></li>
  </ul>

  {{#if isAttack}}
  {{!-- The three Strikes (PHB v4.10): how much of yourself is behind the blow. --}}
  <div class="form-group sw-strike-choice">
    <label>{{localize "STARWROUGHT.Roll.strikeKind"}}</label>
    <div class="form-fields">
      {{#if lockStrike}}
      <strong>{{strikeGlyph}} {{strikeLabel}}</strong>
      {{else}}
      {{#each strikes as |s|}}
      <label class="sw-choice {{#if s.active}}sw-active{{/if}}" data-tooltip="{{s.hint}}">
        <input type="radio" name="strike" value="{{s.key}}" {{#if s.active}}checked{{/if}}>
        <span>{{s.glyph}} {{s.label}}{{#if s.prepared}} · {{localize "STARWROUGHT.Strike.preparedTag"}}{{/if}}</span>
      </label>
      {{/each}}
      {{/if}}
    </div>
  </div>
  {{#unless lockStrike}}
  <p class="hint">{{localize "STARWROUGHT.Strike.dialogHint"}}</p>
  {{/unless}}
  {{/if}}

  {{#if reactions.length}}
  {{!-- Answering an Attack (PHB v4.10): the basic Defense always rolls; a Reaction is paid from the same six. --}}
  <div class="form-group sw-reaction-choice">
    <label>{{localize "STARWROUGHT.Roll.reactionChoice"}}</label>
    <div class="form-fields">
      <label class="sw-choice {{#unless cfg.reaction}}sw-active{{/unless}}">
        <input type="radio" name="reaction" value="" {{#unless cfg.reaction}}checked{{/unless}}>
        <span>{{localize "STARWROUGHT.Roll.noReaction"}}</span>
      </label>
      {{#each reactions as |r|}}
      <label class="sw-choice {{#if r.active}}sw-active{{/if}}" data-tooltip="{{r.hint}}">
        <input type="radio" name="reaction" value="{{r.key}}" {{#if r.active}}checked{{/if}}>
        <span>{{r.glyph}} {{r.label}}{{#if r.defense}} · {{r.defense}}{{/if}}{{#if r.warn}} <i class="fa-solid fa-triangle-exclamation" data-tooltip="{{localize 'STARWROUGHT.Reaction.needsRigid'}}"></i>{{/if}}</span>
      </label>
      {{/each}}
    </div>
  </div>
  {{/if}}

  {{#if (ne actionsLeft null)}}
  <p class="hint">{{localize "STARWROUGHT.Roll.actionsLeft" left=actionsLeft}}</p>
  {{/if}}

  <div class="form-group">
    <label>{{localize "STARWROUGHT.Roll.situational"}}</label>
    <div class="form-fields">
      <input type="number" name="bonus" value="0" step="1" autofocus>
    </div>
  </div>

  {{#if targetDefense}}
  {{!-- The defender's choice meets this roll, but it is theirs to reveal: the card shows it. --}}
  <div class="form-group">
    <label>{{localize "STARWROUGHT.Roll.targetDefense"}}{{#if targetName}} · {{targetName}}{{/if}}</label>
    <div class="form-fields sw-answering">
      {{#if defenseForced}}
      <strong>{{targetDefense.label}}</strong>
      {{else}}
      <span class="sw-answering-note"><i class="fa-solid fa-eye-slash"></i> {{localize "STARWROUGHT.Stance.hidden"}}</span>
      {{/if}}
    </div>
  </div>
  <p class="hint">{{localize "STARWROUGHT.Stance.dialogHint"}}</p>
  {{else}}
  <div class="form-group">
    <label>{{#if isDefense}}{{localize "STARWROUGHT.Roll.attackThreshold"}}{{else}}{{localize "STARWROUGHT.Field.threshold"}}{{/if}}</label>
    <div class="form-fields">
      <input type="number" name="threshold" value="{{threshold}}"
             placeholder="{{localize 'STARWROUGHT.Roll.thresholdPlaceholder'}}">
    </div>
  </div>
  {{/if}}

  <div class="form-group">
    <label>{{localize "CHAT.RollVisibility"}}</label>
    <div class="form-fields">
      <select name="rollMode">{{selectOptions rollModes selected=rollMode localize=true}}</select>
    </div>
  </div>

</div>
