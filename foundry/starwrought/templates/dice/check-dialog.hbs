{{!-- Everything you have to decide before the die leaves your hand. --}}
{{!-- A div, not a form: DialogV2 supplies the form, and a nested one is dropped by the parser. --}}
<div class="check-dialog-form">

  <ul class="sw-card-modifiers">
    {{#each parts as |mod|}}
    <li><span>{{mod.label}}</span><strong>{{swSigned mod.value}}</strong></li>
    {{/each}}
    <li class="sw-total"><span>{{localize "STARWROUGHT.Roll.beforeTheDie"}}</span><strong>{{swSigned total}}</strong></li>
  </ul>

  {{#if isAttack}}
  {{!-- The three Strikes (PHB v4.10): how much of yourself is behind the blow. --}}
  <div class="form-group sw-strike-choice">
    <label>{{localize "STARWROUGHT.Roll.strikeKind"}}</label>
    <div class="form-fields">
      {{#if lockStrike}}
      <strong>{{strikeGlyph}} {{strikeLabel}}</strong>
      {{else}}
      {{#each strikes as |s|}}
      <label class="sw-dialog-option {{#if s.active}}sw-active{{/if}}" data-tooltip="{{s.hint}}">
        <input type="radio" name="strike" value="{{s.key}}" {{#if s.active}}checked{{/if}}>
        <span>{{s.glyph}} {{s.label}}{{#if s.prepared}} · {{localize "STARWROUGHT.Strike.preparedTag"}}{{/if}}</span>
      </label>
      {{/each}}
      {{/if}}
    </div>
  </div>
  {{#unless lockStrike}}
  <p class="hint">{{localize "STARWROUGHT.Strike.dialogHint"}}</p>
  {{/unless}}
  {{#if maneuvers.length}}
  {{!-- A Strike made as part of another Maneuver (PHB v4.21): its Key Attribute may stand in when higher. --}}
  <div class="form-group sw-maneuver-choice">
    <label data-tooltip="{{localize 'STARWROUGHT.Roll.maneuverHint'}}">{{localize "STARWROUGHT.Roll.maneuverChoice"}}</label>
    <div class="form-fields">
      <select name="maneuver">
        <option value="">{{localize "STARWROUGHT.Roll.noManeuver" attribute=attributeLabel}}</option>
        {{#each maneuvers as |m|}}
        <option value="{{m.id}}">{{m.label}}</option>
        {{/each}}
      </select>
    </div>
  </div>
  {{/if}}
  {{/if}}

  {{#if reactions.length}}
  {{!-- Answering an Attack (PHB v4.10): the basic Defense always rolls; a Reaction is paid from the same six. --}}
  <div class="form-group sw-reaction-choice">
    <label>{{localize "STARWROUGHT.Roll.reactionChoice"}}</label>
    <div class="form-fields">
      <label class="sw-dialog-option {{#unless cfg.reaction}}sw-active{{/unless}}">
        <input type="radio" name="reaction" value="" {{#unless cfg.reaction}}checked{{/unless}}>
        <span>{{localize "STARWROUGHT.Roll.noReaction"}}</span>
      </label>
      {{#each reactions as |r|}}
      <label class="sw-dialog-option {{#if r.active}}sw-active{{/if}}" data-tooltip="{{r.hint}}">
        <input type="radio" name="reaction" value="{{r.key}}" {{#if r.active}}checked{{/if}}>
        <span>{{r.glyph}} {{r.label}}{{#if r.defense}} · {{r.defense}}{{/if}}{{#if r.warn}} <i class="fa-solid fa-triangle-exclamation" data-tooltip="{{localize 'STARWROUGHT.Reaction.needsRigid'}}"></i>{{/if}}</span>
      </label>
      {{/each}}
    </div>
  </div>
  {{/if}}

  {{#if (ne actionsLeft null)}}
  <p class="hint">{{localize "STARWROUGHT.Roll.actionsLeft" left=actionsLeft}}</p>
  {{/if}}

  <div class="form-group">
    <label>{{localize "STARWROUGHT.Roll.situational"}}</label>
    <div class="form-fields">
      <input type="number" name="bonus" value="0" step="1" autofocus>
    </div>
  </div>

  {{#each extras as |x|}}
  {{!-- A modifier the engine can name but not decide (Load Strain on a Climb or a Swim, PHB v4.11): offered unticked. --}}
  <div class="form-group sw-extra-choice">
    <label class="sw-dialog-option" data-tooltip="{{x.hint}}">
      <input type="checkbox" name="extra-{{x.key}}" {{#if x.checked}}checked{{/if}}>
      <span>{{x.label}}</span>
    </label>
    <div class="form-fields"><strong>{{swSigned x.value}}</strong></div>
  </div>
  {{/each}}

  {{#if targetDefense}}
  {{!-- The defender committed a Defense in the Combat Prompt; it is revealed on the card, never here. --}}
  <div class="form-group">
    <label>{{localize "STARWROUGHT.Roll.targetDefense"}}{{#if targetName}} · {{targetName}}{{/if}}</label>
    <div class="form-fields sw-answering">
      {{#if targetDefense.label}}
      <strong>{{targetDefense.label}}</strong>
      {{else}}
      <span class="sw-answering-note"><i class="fa-solid fa-eye-slash"></i> {{localize "STARWROUGHT.Roll.defenseCommitted"}}</span>
      {{/if}}
    </div>
  </div>
  <p class="hint">{{localize "STARWROUGHT.Roll.defenseCommittedHint"}}</p>
  {{else if thresholdWithheld}}
  {{!-- The attack flow's Defense roll: the Attack Threshold is the coordinator's, read on the card. --}}
  <p class="hint"><i class="fa-solid fa-eye-slash"></i> {{localize "STARWROUGHT.Roll.thresholdWithheld"}}</p>
  {{else}}
  <div class="form-group">
    <label>{{#if isDefense}}{{localize "STARWROUGHT.Roll.attackThreshold"}}{{else}}{{localize "STARWROUGHT.Field.threshold"}}{{/if}}</label>
    <div class="form-fields">
      <input type="number" name="threshold" value="{{threshold}}"
             placeholder="{{localize 'STARWROUGHT.Roll.thresholdPlaceholder'}}">
    </div>
  </div>
  {{/if}}

  <div class="form-group">
    <label>{{localize "CHAT.RollVisibility"}}</label>
    <div class="form-fields">
      <select name="rollMode"{{#if lockRollMode}} disabled data-tooltip="{{localize 'STARWROUGHT.Roll.rollModeLocked'}}"{{/if}}>{{selectOptions rollModes selected=rollMode localize=true}}</select>
    </div>
  </div>

</div>
