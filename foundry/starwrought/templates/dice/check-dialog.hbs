{{!-- Everything you have to decide before the die leaves your hand. --}}
<form class="starwrought check-dialog-form">

  <ul class="sw-card-modifiers">
    {{#each parts as |mod|}}
    <li><span>{{mod.label}}</span><strong>{{swSigned mod.value}}</strong></li>
    {{/each}}
    <li class="sw-total"><span>{{localize "STARWROUGHT.Roll.beforeTheDie"}}</span><strong>{{swSigned total}}</strong></li>
  </ul>

  <div class="form-group">
    <label>{{localize "STARWROUGHT.Roll.situational"}}</label>
    <div class="form-fields">
      <input type="number" name="bonus" value="0" step="1" autofocus>
    </div>
  </div>

  {{#if targetDefenses}}
  {{!-- The defender's stance is preselected; the list stays for the table that rules otherwise. --}}
  <div class="form-group">
    <label>{{localize "STARWROUGHT.Roll.targetDefense"}}{{#if targetName}} · {{targetName}}{{/if}}</label>
    <div class="form-fields">
      <select name="defenseKey">
        {{#each targetDefenses as |def|}}
        <option value="{{def.key}}" {{#if def.selected}}selected{{/if}}>
          {{def.label}} ({{def.threshold}}){{#if def.isStance}} · {{localize "STARWROUGHT.Stance.tag"}}{{/if}}{{#if def.unavailable}} · {{localize "STARWROUGHT.Stance.unavailableTag"}} ({{def.unavailable}}){{/if}}
        </option>
        {{/each}}
      </select>
    </div>
    {{#if targetStance}}
    <p class="hint">{{localize "STARWROUGHT.Stance.dialogHint"}}</p>
    {{/if}}
  </div>
  {{else}}
  <div class="form-group">
    <label>{{localize "STARWROUGHT.Field.threshold"}}</label>
    <div class="form-fields">
      <input type="number" name="threshold" value="{{threshold}}"
             placeholder="{{localize 'STARWROUGHT.Roll.thresholdPlaceholder'}}">
    </div>
  </div>
  {{/if}}

  {{#if isAttack}}
  <div class="form-group">
    <label>{{localize "STARWROUGHT.Roll.map"}}</label>
    <div class="form-fields">
      <select name="mapIndex">
        {{#each mapLadder as |step|}}
        <option value="{{step.index}}" {{#if (eq step.index @root.cfg.mapIndex)}}selected{{/if}}>{{step.label}}</option>
        {{/each}}
      </select>
    </div>
  </div>
  {{/if}}

  <div class="form-group">
    <label>{{localize "CHAT.RollVisibility"}}</label>
    <div class="form-fields">
      <select name="rollMode">{{selectOptions rollModes selected=rollMode localize=true}}</select>
    </div>
  </div>

</form>
