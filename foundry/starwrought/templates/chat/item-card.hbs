{{!-- An Item put on the table without a roll. --}}
<div class="starwrought item-card">
  <header class="sw-card-header">
    <img src="{{item.img}}" alt="{{item.name}}">
    <div class="sw-card-titles">
      {{!-- The name without the glyph the data carries in it; the cost is printed once, in gold (0.5.1, T16). --}}
      <h3>{{swPlainName item.name}}{{#if item.system.glyph}} <span class="sw-action-glyph sw-card-glyph">{{item.system.glyph}}</span>{{/if}}</h3>
      {{#if subtitle}}<span class="sw-card-subtitle">{{subtitle}}</span>{{/if}}
    </div>
  </header>

  {{#if traits.length}}
  <div class="sw-trait-list">
    {{#each traits as |trait|}}<span class="sw-trait">{{trait}}</span>{{/each}}
  </div>
  {{/if}}

  {{#if item.system.prerequisites}}
  <p class="sw-card-note"><strong>{{localize "STARWROUGHT.Field.prerequisites"}}</strong> {{item.system.prerequisites}}</p>
  {{/if}}
  {{#if item.system.requirements}}
  <p class="sw-card-note"><strong>{{localize "STARWROUGHT.Field.requirements"}}</strong> {{item.system.requirements}}</p>
  {{/if}}
  {{#if item.system.trigger}}
  <p class="sw-card-note"><strong>{{localize "STARWROUGHT.Field.trigger"}}</strong> {{item.system.trigger}}</p>
  {{/if}}
  {{#if item.system.frequency}}
  <p class="sw-card-note"><strong>{{localize "STARWROUGHT.Field.frequency"}}</strong> {{item.system.frequency}}</p>
  {{/if}}
  {{#if item.system.range}}
  <p class="sw-card-note"><strong>{{localize "STARWROUGHT.Field.range"}}</strong> {{item.system.range}}</p>
  {{/if}}
  {{#if item.system.target}}
  <p class="sw-card-note"><strong>{{localize "STARWROUGHT.Field.target"}}</strong> {{item.system.target}}</p>
  {{/if}}
  {{#if item.system.duration}}
  <p class="sw-card-note"><strong>{{localize "STARWROUGHT.Field.duration"}}</strong> {{item.system.duration}}</p>
  {{/if}}

  {{#if flavor}}
  <div class="sw-card-flavor">{{{flavor}}}</div>
  {{/if}}
  {{#if description}}
  <div class="sw-card-description">{{{description}}}</div>
  {{/if}}

  {{#if outcomes}}
  <ul class="sw-card-outcomes">
    {{#each outcomes as |row|}}
    <li><strong>{{localize row.label}}</strong> {{row.text}}</li>
    {{/each}}
  </ul>
  {{/if}}

  {{!-- What using the Talent did (0.15.0): the kinds' lines, a mark named and the like. --}}
  {{#each lines as |line|}}
  <p class="sw-card-note sw-use-note"><i class="fa-solid fa-bolt"></i> {{line}}</p>
  {{/each}}
</div>
