{{!-- Forward only when the step is finished; back always, and back takes its choices with it. --}}
<footer class="sw-chargen-footer">
  <button type="button" data-action="cancel" class="sw-cancel">
    <i class="fa-solid fa-trash"></i> {{localize "STARWROUGHT.Chargen.cancel"}}
  </button>

  {{#unless complete}}
  {{#if outstanding.length}}
  {{!-- Name what is blocking, since it is often below the fold; the arrow appears when it is. --}}
  <div class="sw-outstanding">
    <i class="fa-solid fa-circle-exclamation"></i>
    <span class="sw-outstanding-lead">{{localize "STARWROUGHT.Chargen.nextNeeds"}}</span>
    {{#each outstanding as |o|}}
    {{#if o.id}}
    <a data-action="revealSlot" data-slot="{{o.id}}"
       data-tooltip="{{localize 'STARWROUGHT.Chargen.revealSlot'}}">{{o.label}}</a>
    {{else}}
    <span>{{o.label}}</span>
    {{/if}}
    {{/each}}
    <i class="fa-solid fa-arrow-down sw-fold-arrow" data-tooltip="{{localize 'STARWROUGHT.Chargen.moreBelow'}}"></i>
  </div>
  {{/if}}
  {{/unless}}

  <div class="sw-chargen-nav">
    <button type="button" data-action="back" {{#if isFirst}}disabled{{/if}}>
      <i class="fa-solid fa-arrow-left"></i> {{localize "STARWROUGHT.Chargen.back"}}
    </button>

    {{#if isLast}}
    <button type="button" data-action="finish" class="sw-primary">
      <i class="fa-solid fa-check"></i> {{localize "STARWROUGHT.Chargen.finish"}}
    </button>
    {{else}}
    <button type="button" data-action="next" class="sw-primary" {{#unless complete}}disabled
            data-tooltip="{{#if outstanding.length}}{{localize 'STARWROUGHT.Chargen.nextNeeds'}} {{#each outstanding as |o|}}{{o.label}}{{#unless @last}}, {{/unless}}{{/each}}{{else}}{{localize 'STARWROUGHT.Chargen.incomplete'}}{{/if}}"{{/unless}}>
      {{localize "STARWROUGHT.Chargen.next"}} <i class="fa-solid fa-arrow-right"></i>
    </button>
    {{/if}}
  </div>
</footer>
