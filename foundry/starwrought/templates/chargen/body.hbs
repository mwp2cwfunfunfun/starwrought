{{!-- One step at a time, with the build so far along the side. --}}
<div class="sw-chargen-body">

  <section class="sw-chargen-main">

    {{#if cards}}
    <div class="sw-panel">
      <h3 class="sw-panel-title">
        {{localize (concat "STARWROUGHT.Chargen.step." stepId)}}
        {{#if parentName}}<span class="sw-points">{{parentName}}</span>{{/if}}
      </h3>
      <p class="sw-note">{{localize (concat "STARWROUGHT.Chargen.blurb." stepId)}}</p>
      <div class="sw-choice-grid">
        {{#each cards as |card|}}
        <a class="sw-choice {{#if card.chosen}}chosen{{/if}}"
           data-action="{{@root.chooseAction}}" data-key="{{card.key}}">
          <div class="sw-choice-head">
            {{#if card.img}}<img src="{{card.img}}" alt="{{card.name}}">{{/if}}
            <span class="sw-choice-name">{{card.name}}</span>
            {{#if card.chosen}}<i class="fa-solid fa-circle-check"></i>{{/if}}
          </div>
          {{#if card.lines.length}}
          <div class="sw-choice-lines">
            {{#each card.lines as |line|}}<span class="sw-item-tag">{{line}}</span>{{/each}}
          </div>
          {{/if}}
          <div class="sw-choice-text">{{{card.description}}}</div>
        </a>
        {{/each}}
      </div>
      {{#if (eq stepId "training")}}
      <p class="sw-note">{{localize "STARWROUGHT.Chargen.trainingFooter"}}</p>
      {{/if}}
    </div>
    {{/if}}

    {{#if (eq stepId "defenses")}}
    {{!-- The decision at this step is which threat goes unanswered, so show the four threats and
          which of their two Defenses is Trained. Two Trained Defenses cover three. --}}
    <div class="sw-panel">
      <h3 class="sw-panel-title">
        {{localize "STARWROUGHT.Chargen.coverageTitle"}}
        <span class="sw-points">
          {{#if uncovered.length}}{{localize "STARWROUGHT.Chargen.coverageGap"}} {{swJoin uncovered ", "}}
          {{else}}{{localize "STARWROUGHT.Chargen.coverageFull"}}{{/if}}
        </span>
      </h3>
      <p class="sw-note">{{localize "STARWROUGHT.Chargen.coverageHint"}}</p>
      <div class="sw-trait-list">
        {{#each coverage as |t|}}
        <span class="sw-trait {{#if t.covered}}sw-good-tag{{/if}}">
          <strong>{{t.label}}</strong>:
          {{#each t.defenses as |d|}}{{#if d.trained}}<b>{{d.label}}</b>{{else}}<em>{{d.label}}</em>{{/if}}{{#unless @last}} / {{/unless}}{{/each}}
          {{#if t.covered}}<i class="fa-solid fa-circle-check"></i>{{else}}<i class="fa-solid fa-circle-exclamation"></i>{{/if}}
        </span>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{#each slots as |slot|}}
    <div class="sw-panel sw-slot {{#if slot.done}}sw-slot-done{{/if}} {{#if slot.stuck}}sw-slot-stuck{{/if}}"
         data-slot-id="{{slot.id}}">
      <h3 class="sw-panel-title">
        {{slot.label}}
        <span class="sw-points">
          {{#if slot.done}}<i class="fa-solid fa-circle-check"></i> {{localize "STARWROUGHT.Chargen.spent"}}
          {{else}}{{slot.remaining}} {{localize "STARWROUGHT.Chargen.unspent"}}{{/if}}
        </span>
      </h3>
      {{#if slot.hint}}<p class="sw-note">{{slot.hint}}</p>{{/if}}

      {{#if slot.spent.length}}
      <div class="sw-trait-list">
        {{#each slot.spent as |s|}}
        <span class="sw-trait sw-spent-chip {{#if s.auto}}sw-auto-chip{{/if}}">
          {{s.constellation}}: {{s.name}}
          {{#if s.auto}}
          {{!-- Nothing else was legal, so there is nothing to take it back to. --}}
          <i class="fa-solid fa-lock" data-tooltip="{{localize 'STARWROUGHT.Chargen.autoSpent'}}"></i>
          {{else}}
          <a data-action="undoSpend" data-slot="{{slot.id}}" data-item="{{s.itemId}}"
             data-tooltip="{{localize 'STARWROUGHT.Chargen.undoSpend'}}"><i class="fa-solid fa-xmark"></i></a>
          {{/if}}
        </span>
        {{/each}}
      </div>
      {{/if}}

      {{#unless slot.done}}
      {{#if slot.stuck}}
      <p class="sw-note sw-warn">{{localize "STARWROUGHT.Chargen.stuck"}}</p>
      {{else}}
      <div class="sw-picker">
        {{#if slot.single}}
        <div class="sw-picker-single">{{slot.singleName}}</div>
        {{else}}
        {{!-- Every Constellation this point may go to, shown. A dropdown that opens already set to
              the first entry reads as a decision somebody already made for you. --}}
        <div class="sw-picker-hint {{#if slot.selected}}sw-hidden{{/if}}">
          {{localize "STARWROUGHT.Chargen.pickConstellation"}}
        </div>
        {{#each slot.chipGroups as |grp|}}
        <div class="sw-chip-group">
          {{#if (gt slot.chipGroups.length 1)}}<span class="sw-chip-group-label">{{grp.label}}</span>{{/if}}
          <div class="sw-chip-row">
            {{#each grp.constellations as |c|}}
            <a class="sw-con-chip {{#if c.active}}active{{/if}}" data-action="pickConstellation"
               data-slot="{{slot.id}}" data-slug="{{c.slug}}"
               {{#if c.tooltip}}data-tooltip="{{c.tooltip}}"{{/if}}>
              <span class="sw-glyph sw-glyph-{{c.attribute}}">{{c.glyph}}</span>
              <span class="sw-con-chip-name">{{c.name}}</span>
              <em>{{c.available}}</em>
            </a>
            {{/each}}
          </div>
        </div>
        {{/each}}
        {{/if}}

        {{!-- Every list is rendered; the chips show one of them. Toggling beats re-rendering. --}}
        {{#each slot.groups as |g|}}
        <ul class="sw-talent-options {{#if g.active}}active{{/if}}" data-group="{{g.slug}}">
          {{#if g.parentNote}}
          {{!-- A Combat Style is a child of Melee or Ranged: its points count toward that rank too. --}}
          <li class="sw-note">
            <i class="fa-solid fa-arrow-turn-up"></i>
            {{g.parentNote}}
          </li>
          {{/if}}
          {{#each g.talents as |t|}}
          {{!-- The whole card is the button. A target the size of the name alone was missed. --}}
          <li class="sw-talent-option {{#unless t.ok}}locked{{/unless}}"
              {{#if t.ok}}data-action="buyTalent" role="button" tabindex="0"{{else}}aria-disabled="true" data-tooltip="{{t.why}}"{{/if}}
              data-slot="{{slot.id}}" data-slug="{{t.slug}}" data-talent="{{t.id}}">
            <div class="sw-talent-head">
              <span class="sw-tier sw-tier-{{t.tier}}">{{t.tier}}</span>
              <span class="sw-talent-name">{{t.name}}{{#if t.root}} <em class="sw-root-mark">✧</em>{{/if}}</span>
            </div>
            <div class="sw-talent-effect">{{{t.effect}}}</div>
          </li>
          {{/each}}
        </ul>
        {{/each}}
      </div>
      {{/if}}
      {{/unless}}
    </div>
    {{/each}}

    {{!-- Shown by the wizard only while an unspent point sits below the fold; it sticks to the
          bottom edge of the pane, which is where the eye goes when Next will not light. --}}
    <a class="sw-scroll-cue" data-action="revealSlot" data-slot="" hidden>
      <i class="fa-solid fa-angles-down"></i>
      {{localize "STARWROUGHT.Chargen.moreBelow"}}
      <i class="fa-solid fa-angles-down"></i>
    </a>

    {{#if (eq stepId "review")}}
    <div class="sw-panel">
      <h3 class="sw-panel-title">{{localize "STARWROUGHT.Chargen.step.review"}}</h3>
      <p class="sw-note">{{localize "STARWROUGHT.Chargen.blurb.review"}}</p>
      <label class="sw-field sw-wide">
        <span>{{localize "STARWROUGHT.Chargen.name"}}</span>
        <input type="text" name="charname" value="{{actor.name}}">
      </label>
      <div class="sw-review-grid">
        <div><span>{{localize "STARWROUGHT.Chassis.ancestry"}}</span><strong>{{system.details.ancestry.name}}</strong></div>
        <div><span>{{localize "STARWROUGHT.Chassis.bloodline"}}</span><strong>{{system.details.bloodline.name}}</strong></div>
        <div><span>{{localize "STARWROUGHT.Chassis.culture"}}</span><strong>{{system.details.culture.name}}</strong></div>
        <div><span>{{localize "STARWROUGHT.Chassis.background"}}</span><strong>{{system.details.background.name}}</strong></div>
        <div><span>{{localize "STARWROUGHT.Chassis.calling"}}</span><strong>{{system.details.calling.name}}</strong></div>
        <div><span>{{localize "STARWROUGHT.Field.languages"}}</span><strong>{{system.details.languages}}</strong></div>
        <div>
          <span>{{localize "STARWROUGHT.Chargen.weaponTraining"}}</span>
          <strong>{{#each review.training as |t|}}{{#if t.trained}}{{t.name}} {{/if}}{{/each}}</strong>
        </div>
        <div><span>{{localize "STARWROUGHT.Field.speed"}}</span><strong>{{review.speed}} ft</strong></div>
      </div>
    </div>

    {{!-- Finishing Up, with this character's numbers in the formulas. --}}
    <div class="sw-panel">
      <h3 class="sw-panel-title">{{localize "STARWROUGHT.Chargen.finishingUp"}}</h3>
      <div class="sw-review-grid">
        <div>
          <span>{{localize "STARWROUGHT.Field.vigor"}}</span>
          <strong>{{review.vigor.formula}}</strong>
        </div>
        <div>
          <span>{{localize "STARWROUGHT.Section.attributes"}}</span>
          <strong>{{review.attributeRule}}</strong>
        </div>
        <div>
          <span>{{localize "STARWROUGHT.Field.rank"}}</span>
          <strong>{{review.rankRule}}</strong>
        </div>
        <div>
          <span>{{localize "STARWROUGHT.Chargen.talentsSoFar"}}</span>
          <strong>
            {{localize "STARWROUGHT.Chargen.talentCount" talents=review.talents minimum=review.minimum}}
            {{#if review.short}}<i class="fa-solid fa-circle-exclamation sw-warn" data-tooltip="{{localize 'STARWROUGHT.Chargen.talentsShort' n=review.short}}"></i>{{/if}}
          </strong>
        </div>
      </div>
    </div>
    {{/if}}

  </section>

  <aside class="sw-chargen-rail">
    <h4>{{localize "STARWROUGHT.Chargen.buildSoFar"}}</h4>

    <div class="sw-rail-attributes">
      {{#each summary.attributes as |a|}}
      <div class="sw-rail-attribute" data-tooltip="{{a.label}}: {{a.points}} {{localize 'STARWROUGHT.Field.points'}}">
        <span class="sw-glyph sw-glyph-{{a.key}}">{{a.glyph}}</span>
        <strong>{{swSigned a.mod}}</strong>
      </div>
      {{/each}}
    </div>

    <div class="sw-rail-line" data-tooltip="{{summary.vigor.formula}}">
      <span>{{localize "STARWROUGHT.Field.vigor"}}</span><strong>{{summary.vigor.total}}</strong>
    </div>
    {{#each summary.defenses as |d|}}
    <div class="sw-rail-line">
      <span>{{d.label}}</span><strong>{{swSigned d.mod}} / {{d.threshold}}</strong>
    </div>
    {{/each}}

    <h4>{{localize "STARWROUGHT.Chargen.talentsSoFar"}} <span class="sw-points">{{summary.talents}} / {{summary.minimum}}</span></h4>
    <ul class="sw-rail-constellations">
      {{#each summary.constellations as |c|}}
      <li data-tooltip="{{c.rank}} {{c.bonus}}">
        <span class="sw-glyph">{{c.glyph}}</span>
        <span class="sw-rail-name">{{c.name}}</span>
        <span class="sw-points">{{c.points}}{{#if c.inherited}} <em>(+{{c.inherited}})</em>{{/if}}</span>
      </li>
      {{else}}
      <li class="sw-empty">{{localize "STARWROUGHT.Chargen.nothingYet"}}</li>
      {{/each}}
    </ul>
  </aside>

</div>
