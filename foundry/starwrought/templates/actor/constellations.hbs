{{!-- The sky: every Constellation this character has actually invested in, and, with the toggle on
      (0.6.3, ruling 85), every Constellation that ships and has not been opened, dimmed. --}}
<section class="tab sw-tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">

  <div class="sw-tab-toolbar">
    {{!-- Opened only, or every Constellation: a client setting, so it is this user's everywhere. --}}
    {{#if showUnopened}}
    <button type="button" class="sw-inline-button sw-active" data-action="toggleUnopened"
            data-tooltip="{{localize 'STARWROUGHT.Sheet.hideUnopenedHint'}}">
      <i class="fa-solid fa-eye-slash"></i> {{localize "STARWROUGHT.Sheet.hideUnopened"}}
    </button>
    {{else}}
    <button type="button" class="sw-inline-button" data-action="toggleUnopened"
            data-tooltip="{{localize 'STARWROUGHT.Sheet.showUnopenedHint'}}">
      <i class="fa-solid fa-eye"></i> {{localize "STARWROUGHT.Sheet.showUnopened"}}
    </button>
    {{/if}}
    {{!-- A check whose Constellation is yours to choose and the GM's to approve. --}}
    <button type="button" class="sw-inline-button" data-action="relevantCheck"
            data-tooltip="{{localize 'STARWROUGHT.Sheet.relevantCheckHint'}}">
      <i class="fa-solid fa-scale-balanced"></i> {{localize "STARWROUGHT.Roll.relevantCheck"}}
    </button>
  </div>

  {{#if constellations.length}}
  {{#each constellations as |group|}}
  <div class="sw-panel sw-constellation-group">
    <h3 class="sw-panel-title">
      {{group.label}}
      {{#if group.pooled}}
      <span class="sw-points" data-tooltip="{{group.pooledHint}}">
        {{group.pooled}} {{localize "STARWROUGHT.Field.pointsShort"}} {{localize "STARWROUGHT.Field.pooled"}}
      </span>
      {{/if}}
    </h3>

    {{#each group.constellations as |con|}}
    <div class="sw-constellation {{#if con.flared}}sw-flared{{/if}} {{#if con.unopened}}sw-unopened{{/if}}" data-slug="{{con.slug}}">

      <div class="sw-constellation-head">
        {{#if con.unopened}}
        {{!-- Nothing to fold on an unopened row; the blank keeps the names aligned. --}}
        <span class="sw-collapse sw-collapse-blank"></span>
        {{else}}
        <a class="sw-collapse" data-action="toggleCollapse" data-slug="{{con.slug}}">
          <i class="fa-solid {{#if con.collapsed}}fa-caret-right{{else}}fa-caret-down{{/if}}"></i>
        </a>
        {{/if}}

        <a class="sw-constellation-name" data-action="rollConstellation" data-slug="{{con.slug}}"
           data-tooltip="STARWROUGHT.Roll.rollHint">
          <span class="sw-glyph sw-glyph-{{con.attribute}}">{{con.attributeGlyph}}</span>
          {{con.name}}
        </a>

        <span class="sw-rank sw-rank-{{con.rank}}" data-tooltip="{{con.attributeLabel}}">
          {{con.rankLabel}} {{swSigned con.bonus}}
        </span>

        {{#if con.unopened}}
        {{!-- Not opened: no Item, no Talent. Untrained, and still a sky a critical can Flare. --}}
        <span class="sw-points sw-unopened-mark" data-tooltip="STARWROUGHT.Field.unopenedHint">
          {{localize "STARWROUGHT.Sheet.notOpened"}}
        </span>
        {{else if con.inherited}}
        {{!-- A parent Constellation: its Combat Styles' points count toward its rank. --}}
        <span class="sw-points" data-tooltip="STARWROUGHT.Field.inheritedHint">
          {{con.pool}} {{swPlural con.pool (localize "STARWROUGHT.Field.pointShort") (localize "STARWROUGHT.Field.pointsShort")}},
          {{localize "STARWROUGHT.Field.inheritedPoints" n=con.inherited}}
        </span>
        {{else}}
        <span class="sw-points" data-tooltip="STARWROUGHT.Field.pointsHint">
          {{con.points}} {{swPlural con.points (localize "STARWROUGHT.Field.pointShort") (localize "STARWROUGHT.Field.pointsShort")}}
        </span>
        {{/if}}

        {{#if con.parentName}}
        <span class="sw-parent" data-tooltip="STARWROUGHT.Field.inheritedHint">
          <i class="fa-solid fa-arrow-turn-up"></i> {{localize "STARWROUGHT.Field.childOf" parent=con.parentName}}
        </span>
        {{/if}}

        {{#if con.next}}
        <span class="sw-next" data-tooltip="STARWROUGHT.Field.nextRankHint">
          {{localize con.next.label}}:
          {{#if con.next.points}}{{con.next.points}} {{swPlural con.next.points (localize "STARWROUGHT.Field.pointShort") (localize "STARWROUGHT.Field.pointsShort")}}{{/if}}
          {{#if con.next.level}}<em>L{{swAdd @root.system.level con.next.level}}</em>{{/if}}
          {{#unless con.next.points}}{{#unless con.next.level}}<em>{{localize "STARWROUGHT.Field.ready"}}</em>{{/unless}}{{/unless}}
        </span>
        {{/if}}

        <a class="sw-flare" data-action="toggleFlare" data-slug="{{con.slug}}"
           data-tooltip="STARWROUGHT.Field.flareHint">
          <i class="fa-solid fa-certificate"></i>
        </a>
      </div>

      {{#unless con.unopened}}
      {{#unless con.collapsed}}
      <ol class="sw-talent-list">
        {{#each con.talents as |talent|}}
        <li class="sw-talent" data-item-id="{{talent.id}}">
          {{!-- The image opens the Talent (0.5.1, T14); the chat control on the right sends it. The
                name is printed plain, with the gold glyph the one cost shown (T16). --}}
          <img class="sw-talent-img" src="{{talent.img}}" alt="{{talent.name}}"
               data-action="itemEdit" data-tooltip="STARWROUGHT.Sheet.view">
          <span class="sw-tier sw-tier-{{talent.tier}}">{{talent.tier}}</span>
          <span class="sw-talent-name">
            {{swPlainName talent.name}}
            {{#if talent.root}}<em class="sw-root-mark" data-tooltip="STARWROUGHT.Field.rootHint">✧</em>{{/if}}
            {{#if talent.glyph}}<span class="sw-action-glyph">{{talent.glyph}}</span>{{/if}}
          </span>
          {{!-- AURAS (0.5.1): the ring, on a Talent that carries one; lit when Visible. --}}
          {{#with (lookup @root.auraByItem talent.id) as |aura|}}
          <a class="sw-aura-toggle {{#if aura.visible}}sw-aura-on{{/if}}" data-action="toggleAura" data-key="{{aura.key}}"
             data-tooltip="{{aura.tooltip}}" style="--sw-aura-color: {{aura.color}}"><i class="fa-solid fa-circle-dot"></i></a>
          {{/with}}
          <div class="sw-talent-controls">
            <a data-action="itemChat" data-tooltip="STARWROUGHT.Sheet.toChat"><i class="fa-solid fa-comment"></i></a>
            {{#if @root.isGM}}
            <a data-action="itemEdit" data-tooltip="STARWROUGHT.Sheet.edit"><i class="fa-solid fa-pen"></i></a>
            {{else}}
            <a data-action="itemEdit" data-tooltip="STARWROUGHT.Sheet.view"><i class="fa-solid fa-eye"></i></a>
            {{/if}}
            <a data-action="itemDelete" data-tooltip="STARWROUGHT.Sheet.delete"><i class="fa-solid fa-trash"></i></a>
          </div>
        </li>
        {{else}}
        <li class="sw-empty">{{localize "STARWROUGHT.Sheet.noTalents"}}</li>
        {{/each}}
      </ol>
      {{/unless}}
      {{/unless}}

    </div>
    {{/each}}
  </div>
  {{/each}}
  {{else}}
  <div class="sw-panel sw-empty-panel">
    <p>{{localize "STARWROUGHT.Sheet.noConstellations"}}</p>
  </div>
  {{/if}}

</section>
