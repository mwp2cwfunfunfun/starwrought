{{!-- Overview: the four Attributes, the four Defenses, the four Zones, and the numbers a fight runs on. --}}
<section class="tab sw-tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">

  {{#if (or chargen.unbuilt chargen.inProgress)}}
  <div class="sw-panel sw-chargen-banner">
    <div>
      <h3>{{#if chargen.inProgress}}{{localize "STARWROUGHT.Chargen.resumeTitle"}}{{else}}{{localize "STARWROUGHT.Chargen.startTitle"}}{{/if}}</h3>
      <p class="sw-note">{{#if chargen.inProgress}}{{localize "STARWROUGHT.Chargen.resumeBlurb"}}{{else}}{{localize "STARWROUGHT.Chargen.startBanner"}}{{/if}}</p>
    </div>
    <button type="button" class="sw-primary" data-action="chargen">
      <i class="fa-solid fa-wand-magic-sparkles"></i>
      {{#if chargen.inProgress}}{{localize "STARWROUGHT.Chargen.resume"}}{{else}}{{localize "STARWROUGHT.Chargen.start"}}{{/if}}
    </button>
  </div>
  {{/if}}

  <div class="sw-panel sw-attributes">
    <h3 class="sw-panel-title">{{localize "STARWROUGHT.Section.attributes"}}</h3>
    <div class="sw-attribute-grid">
      {{#each attributes as |attr|}}
      <div class="sw-attribute" data-attribute="{{attr.key}}"
           data-tooltip="{{localize 'STARWROUGHT.Field.attributePoints'}}: {{attr.points}}">
        <span class="sw-glyph sw-glyph-{{attr.key}}">{{attr.glyph}}</span>
        <span class="sw-attribute-mod">{{swSigned attr.mod}}</span>
        <span class="sw-attribute-name">{{attr.label}}</span>
        <span class="sw-attribute-points">
          {{attr.points}} {{swPlural attr.points (localize "STARWROUGHT.Field.point") (localize "STARWROUGHT.Field.points")}}
          {{#if attr.next}}<em>({{attr.next}} {{localize "STARWROUGHT.Field.toNext"}})</em>{{/if}}
        </span>
      </div>
      {{/each}}
    </div>
    <p class="sw-note">{{localize "STARWROUGHT.Hint.attributes"}}</p>
  </div>

  <div class="sw-panel sw-defenses">
    <h3 class="sw-panel-title">{{localize "STARWROUGHT.Section.defenses"}}</h3>
    <div class="sw-defense-grid">
      {{#each defenses as |def|}}
      <div class="sw-defense {{#if def.isStance}}sw-stance-active{{/if}} {{#unless def.trained}}sw-untrained{{/unless}}">
        {{#if def.isStance}}<span class="sw-stance-tag">{{localize "STARWROUGHT.Stance.tag"}}</span>{{/if}}
        <a class="sw-defense-roll" data-action="rollDefense" data-defense="{{def.key}}"
           data-tooltip="{{def.hint}}">
          <span class="sw-defense-name">{{def.label}}</span>
          <span class="sw-defense-mod">{{swSigned def.mod}}</span>
        </a>
        <div class="sw-defense-meta">
          <span class="sw-threshold" data-tooltip="STARWROUGHT.Field.thresholdHint">
            {{localize "STARWROUGHT.Field.threshold"}} <strong>{{def.threshold}}</strong>
          </span>
          <span class="sw-rank sw-rank-{{def.rank}}">{{def.rankLabel}}</span>
        </div>
      </div>
      {{/each}}
    </div>
  </div>

  <div class="sw-panel sw-zones">
    <h3 class="sw-panel-title">
      {{localize "STARWROUGHT.Section.zones"}}
      <span class="sw-panel-buttons">
        <span class="sw-points" data-tooltip="STARWROUGHT.Field.woundCountHint">
          {{localize "STARWROUGHT.Field.wounds"}} {{woundCount}}
        </span>
        <button type="button" class="sw-inline-button" data-action="recenter"
                data-tooltip="STARWROUGHT.Action.recenterHint">{{swActionGlyph 1}} {{localize "STARWROUGHT.Action.recenter"}}</button>
      </span>
    </h3>
    <div class="sw-zone-grid">
      {{#each zones as |zone|}}
      <div class="sw-zone {{#if zone.exposed}}sw-zone-exposed{{/if}} {{#if zone.wounds.wounded}}sw-zone-wounded{{/if}}">
        <div class="sw-zone-head">
          <span class="sw-zone-name">{{zone.label}}</span>
          <a class="sw-zone-toggle" data-action="toggleZone" data-zone="{{zone.key}}"
             data-tooltip="{{#if zone.exposed}}{{localize 'STARWROUGHT.Zone.closeHint'}}{{else}}{{localize 'STARWROUGHT.Zone.openHint'}}{{/if}}">
            {{#if zone.exposed}}<i class="fa-solid fa-heart-crack"></i>{{else}}<i class="fa-solid fa-shield"></i>{{/if}}
          </a>
        </div>
        <div class="sw-zone-numbers">
          <div class="sw-zone-protection">
            <span class="sw-protection-value">{{zone.protection}}</span>
            <span class="sw-protection-label">{{localize "STARWROUGHT.Field.protection"}}</span>
          </div>
          {{> "systems/starwrought/templates/actor/wounds.hbs" zone.wounds}}
        </div>
        <div class="sw-zone-piece">
          {{#if zone.piece}}{{zone.piece.name}}{{else}}<em>{{localize "STARWROUGHT.Protection.unarmored"}}</em>{{/if}}
        </div>
        {{#if zone.weakTo}}
        <div class="sw-zone-weak" data-tooltip="STARWROUGHT.Hint.materialWeakness">
          {{zone.materialLabel}} · −1 {{localize "STARWROUGHT.Field.vs"}} {{zone.weakTo}}
        </div>
        {{/if}}
        {{#if zone.wounds.effect}}<div class="sw-zone-wound-effect">{{zone.wounds.effect}}</div>{{/if}}
        {{#if zone.exposed}}
        <div class="sw-zone-flag">
          {{!-- The badge opens the rules page for Exposed (0.5.1, T6). --}}
          <a class="sw-rules-link" data-action="rulesPage" data-page="Exposed" data-tooltip="STARWROUGHT.Rules.openExposed">{{localize "STARWROUGHT.Condition.exposed"}}</a>{{#if zone.postureExposed}} <small>({{localize "STARWROUGHT.Reaction.posture"}})</small>{{/if}}
        </div>
        {{/if}}
      </div>
      {{/each}}
    </div>
  </div>

  {{!-- What every Strike rolls: Melee for what is in your hand, Ranged for what leaves it. --}}
  <div class="sw-panel sw-strikes">
    <h3 class="sw-panel-title">{{localize "STARWROUGHT.Section.strikes"}}</h3>
    <div class="sw-strike-grid">
      <div class="sw-strike-training" data-tooltip="STARWROUGHT.Field.meleeHint">
        <span class="sw-glyph sw-glyph-{{strikes.melee.attribute}}">{{swGlyph strikes.melee.attribute}}</span>
        <span class="sw-strike-name">{{strikes.melee.label}}</span>
        <span class="sw-strike-mod">{{swSigned strikes.melee.proficiency}}</span>
        <span class="sw-rank sw-rank-{{strikes.melee.rank}}">{{strikes.melee.rankLabel}}</span>
      </div>
      <div class="sw-strike-training" data-tooltip="STARWROUGHT.Field.rangedHint">
        <span class="sw-glyph sw-glyph-{{strikes.ranged.attribute}}">{{swGlyph strikes.ranged.attribute}}</span>
        <span class="sw-strike-name">{{strikes.ranged.label}}</span>
        <span class="sw-strike-mod">{{swSigned strikes.ranged.proficiency}}</span>
        <span class="sw-rank sw-rank-{{strikes.ranged.rank}}">{{strikes.ranged.rankLabel}}</span>
      </div>
      <div class="sw-field sw-readonly" data-tooltip="STARWROUGHT.Field.weaponDiceHint">
        <span>{{localize "STARWROUGHT.Field.weaponDice"}}</span>
        <strong>{{strikes.weaponDice}}</strong>
      </div>
      <div class="sw-field sw-readonly" data-tooltip="STARWROUGHT.Field.specializationHint">
        <span>{{localize "STARWROUGHT.Field.specialization"}}</span>
        <strong>{{swSigned strikes.melee.specialization}} <em>/</em> {{swSigned strikes.ranged.specialization}}</strong>
      </div>
    </div>
    <div class="sw-strike-kinds">
      {{#each strikes.kinds as |kind|}}
      <span class="sw-strike-kind" data-tooltip="{{kind.hint}}"><b>{{kind.glyph}}</b> {{kind.label}}</span>
      {{/each}}
    </div>
  </div>

  <div class="sw-panel sw-body">
    <h3 class="sw-panel-title">{{localize "STARWROUGHT.Section.body"}}</h3>
    <div class="sw-body-grid">
      <label class="sw-field">
        <span>{{localize "STARWROUGHT.Field.size"}}</span>
        <select name="system.size">{{selectOptions sizeChoices selected=system.size}}</select>
      </label>
      {{!-- Ancestry Vigor, Calling Vigor and Ancestry Speed are set at creation (0.5.1, T8): the
            player reads them, the GM types them. --}}
      <label class="sw-field {{#unless isGM}}sw-locked{{/unless}}" {{#unless isGM}}data-tooltip="{{lockedTips.ancestryVigor}}" data-tooltip-class="sw-tooltip-rich"{{/unless}}>
        <span>{{localize "STARWROUGHT.Field.ancestryVigor"}}</span>
        {{#if isGM}}<input type="number" name="system.details.ancestry.vigor" value="{{system.details.ancestry.vigor}}" min="0">
        {{else}}<strong class="sw-locked-value">{{system.details.ancestry.vigor}}</strong>{{/if}}
      </label>
      <label class="sw-field {{#unless isGM}}sw-locked{{/unless}}" {{#unless isGM}}data-tooltip="{{lockedTips.callingVigor}}" data-tooltip-class="sw-tooltip-rich"{{/unless}}>
        <span>{{localize "STARWROUGHT.Field.callingVigor"}}</span>
        {{#if isGM}}<input type="number" name="system.details.calling.vigor" value="{{system.details.calling.vigor}}" min="0">
        {{else}}<strong class="sw-locked-value">{{system.details.calling.vigor}}</strong>{{/if}}
      </label>
      <label class="sw-field {{#unless isGM}}sw-locked{{/unless}}" {{#if isGM}}data-tooltip="STARWROUGHT.Field.speedHint"{{else}}data-tooltip="{{lockedTips.ancestrySpeed}}" data-tooltip-class="sw-tooltip-rich"{{/if}}>
        <span>{{localize "STARWROUGHT.Field.ancestrySpeed"}}</span>
        {{#if isGM}}<input type="number" name="system.details.ancestry.speed" value="{{system.details.ancestry.speed}}" min="0">
        {{else}}<strong class="sw-locked-value">{{system.details.ancestry.speed}} ft</strong>{{/if}}
      </label>
      <div class="sw-field sw-readonly" data-tooltip="{{totalReachHint}}">
        <span>{{localize "STARWROUGHT.Field.totalReach"}}</span>
        <strong>{{system.totalReach}} ft</strong>
      </div>
      <div class="sw-field sw-readonly">
        <span>{{localize "STARWROUGHT.Field.reach"}}</span>
        <strong>{{system.reach}} ft</strong>
      </div>
      <div class="sw-field sw-readonly">
        <span>{{localize "STARWROUGHT.Field.space"}}</span>
        <strong>{{system.space}} × {{system.space}} ft</strong>
      </div>
      <div class="sw-field sw-readonly {{#if system.loadStrain}}sw-alert{{/if}}"
           data-tooltip="STARWROUGHT.Field.loadStrainHint">
        <span>{{localize "STARWROUGHT.Field.loadStrain"}}</span>
        <strong>{{system.loadStrain}}</strong>
      </div>
      <div class="sw-field sw-readonly">
        <span>{{localize "STARWROUGHT.Field.initiative"}}</span>
        <a data-action="rollInitiative"><strong>{{swSigned system.initiative.mod}}</strong></a>
      </div>
      <label class="sw-field sw-wide">
        <span>{{localize "STARWROUGHT.Field.senses"}}</span>
        <input type="text" name="system.details.ancestry.senses" value="{{system.details.ancestry.senses}}">
      </label>
      <label class="sw-field sw-wide">
        <span>{{localize "STARWROUGHT.Field.languages"}}</span>
        <input type="text" name="system.details.languages" value="{{system.details.languages}}">
      </label>
      <label class="sw-field sw-wide" data-tooltip="STARWROUGHT.Field.familiarityHint">
        <span>{{localize "STARWROUGHT.Field.familiarity"}}</span>
        <input type="text" name="familiarityText" value="{{swJoin system.familiarity}}"
               placeholder="{{localize 'STARWROUGHT.Field.familiarityPlaceholder'}}">
      </label>
    </div>

    {{!-- Movement, in feet. A Move ❶ carries you your Speed; a Step is half and never provokes;
          a Rush ❸ is five Speeds in a straight line, less Load Strain; a Leap ❶ is ten feet, less Load Strain. --}}
    <div class="sw-movement">
      <div class="sw-move" data-tooltip="STARWROUGHT.Field.speedHint">
        <span class="sw-move-label">{{swActionGlyph 1}} {{localize "STARWROUGHT.Field.speed"}}</span>
        <strong>{{movement.speed}} ft</strong>
      </div>
      <div class="sw-move" data-tooltip="STARWROUGHT.Field.stepHint">
        <span class="sw-move-label">{{swActionGlyph 1}} {{localize "STARWROUGHT.Field.step"}}</span>
        <strong>{{movement.step}} ft</strong>
      </div>
      <div class="sw-move" data-tooltip="STARWROUGHT.Field.rushHint">
        <span class="sw-move-label">{{swActionGlyph 3}} {{localize "STARWROUGHT.Field.rush"}}</span>
        <strong>{{movement.rush}} ft</strong>
      </div>
      <div class="sw-move" data-tooltip="STARWROUGHT.Field.leapHint">
        <span class="sw-move-label">{{swActionGlyph 1}} {{localize "STARWROUGHT.Field.leap"}}</span>
        <strong>{{movement.leap}} ft</strong>
      </div>
    </div>

    {{!-- AURAS (0.5.1): the body's own ranges, each with its ring toggle. A Visible ring is pinned on
          the map for everyone while an encounter runs; the rest preview on hover, control and drag. --}}
    {{#if ranges.length}}
    <div class="sw-ranges">
      <span class="sw-ranges-label" data-tooltip="STARWROUGHT.Aura.rangesHint">{{localize "STARWROUGHT.Aura.ranges"}}</span>
      {{#each ranges as |range|}}
      <span class="sw-range-chip {{#if range.visible}}sw-aura-on{{/if}}" style="--sw-aura-color: {{range.color}}">
        <span class="sw-aura-swatch"></span>
        <span class="sw-range-name">{{range.label}}</span>
        <strong>{{range.feet}} ft</strong>
        <a class="sw-aura-toggle {{#if range.visible}}sw-aura-on{{/if}}" data-action="toggleAura" data-key="{{range.key}}"
           data-tooltip="{{range.tooltip}}"><i class="fa-solid fa-circle-dot"></i></a>
      </span>
      {{/each}}
    </div>
    {{/if}}

    {{#if system.matchedHarness}}
    <p class="sw-note sw-good">{{localize "STARWROUGHT.Hint.matchedHarness"}}</p>
    {{/if}}
    {{#if system.clatter}}
    <p class="sw-note sw-warn">{{localize "STARWROUGHT.Hint.clatter"}}</p>
    {{/if}}
  </div>

  <div class="sw-panel sw-actions-bar">
    <h3 class="sw-panel-title">{{localize "STARWROUGHT.Section.quick"}}</h3>
    <div class="sw-button-row">
      <button type="button" data-action="recovery" {{#unless system.dying}}disabled{{/unless}}>
        <i class="fa-solid fa-heart-pulse"></i> {{localize "STARWROUGHT.Roll.recovery"}}
      </button>
      {{!-- Refuse Death is for the Dying with a Hero Point (0.5.1, T13). The tooltip rides on the
            wrapper because a disabled button swallows the hover. --}}
      <span class="sw-button-wrap" data-tooltip="{{refuse.hint}}">
        <button type="button" data-action="refuseDeath" {{#unless refuse.enabled}}disabled{{/unless}}>
          <i class="fa-solid fa-hand"></i> {{localize "STARWROUGHT.Roll.refuseDeath"}}
        </button>
      </span>
      <button type="button" data-action="rest" data-tooltip="{{localize 'STARWROUGHT.Rest.hint'}}">
        <i class="fa-solid fa-bed"></i> {{localize "STARWROUGHT.Rest.title"}}
        <em>({{swSigned vigor.rest}} {{localize "STARWROUGHT.Field.vigor"}})</em>
      </button>
    </div>
  </div>

  <div class="sw-panel sw-modifiers">
    <h3 class="sw-panel-title">{{localize "STARWROUGHT.Section.adjustments"}}</h3>
    <div class="sw-body-grid">
      <label class="sw-field"><span>{{localize "STARWROUGHT.Field.attackBonus"}}</span>
        <input type="number" name="system.bonuses.attack" value="{{system.bonuses.attack}}"></label>
      <label class="sw-field"><span>{{localize "STARWROUGHT.Field.damageBonus"}}</span>
        <input type="number" name="system.bonuses.damage" value="{{system.bonuses.damage}}"></label>
      <label class="sw-field"><span>{{localize "STARWROUGHT.Field.checkBonus"}}</span>
        <input type="number" name="system.bonuses.checks" value="{{system.bonuses.checks}}"></label>
      <label class="sw-field"><span>{{localize "STARWROUGHT.Field.initiativeBonus"}}</span>
        <input type="number" name="system.bonuses.initiative" value="{{system.bonuses.initiative}}"></label>
      <label class="sw-field"><span>{{localize "STARWROUGHT.Field.speedBonus"}}</span>
        <input type="number" name="system.bonuses.speed" value="{{system.bonuses.speed}}"></label>
      <label class="sw-field"><span>{{localize "STARWROUGHT.Field.vigorBonus"}}</span>
        <input type="number" name="system.bonuses.vigor" value="{{system.bonuses.vigor}}"></label>
      <label class="sw-field"><span>{{localize "STARWROUGHT.Field.protectionBonus"}}</span>
        <input type="number" name="system.bonuses.protection" value="{{system.bonuses.protection}}"></label>
      {{#each system.bonuses.defenses as |value key|}}
      <label class="sw-field"><span>{{localize (concat "STARWROUGHT.Defense." key)}}</span>
        <input type="number" name="system.bonuses.defenses.{{key}}" value="{{value}}"></label>
      {{/each}}
      <label class="sw-field sw-wide"><span>{{localize "STARWROUGHT.Field.resistances"}}</span>
        <input type="text" name="resistancesText" value="{{resistancesText}}"
               placeholder="{{localize 'STARWROUGHT.Field.damageModPlaceholder'}}"></label>
      <label class="sw-field sw-wide"><span>{{localize "STARWROUGHT.Field.weaknesses"}}</span>
        <input type="text" name="weaknessesText" value="{{weaknessesText}}"
               placeholder="{{localize 'STARWROUGHT.Field.damageModPlaceholder'}}"></label>
      <label class="sw-field sw-wide"><span>{{localize "STARWROUGHT.Field.immunities"}}</span>
        <input type="text" name="immunitiesText" value="{{immunitiesText}}"
               placeholder="{{localize 'STARWROUGHT.Field.immunitiesPlaceholder'}}"></label>
    </div>
  </div>

</section>
