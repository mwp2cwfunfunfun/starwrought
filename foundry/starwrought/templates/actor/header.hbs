{{!-- Character header: who you are, and what is left in you. --}}
<header class="sw-header">

  <img class="sw-portrait" src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage"
       data-tooltip="STARWROUGHT.Sheet.editImage">

  <div class="sw-header-body">

    <div class="sw-name-row">
      <input class="sw-charname" type="text" name="name" value="{{actor.name}}"
             placeholder="{{localize 'STARWROUGHT.Sheet.namePlaceholder'}}">
      {{!-- Level and Milestones (0.5.1, T11): the GM types them; a player reads a badge, and both
            see the same three star pips, filled as Milestones are reached. The fourth is a level. --}}
      <div class="sw-progress">
        <div class="sw-progress-row">
          {{#if isGM}}
          <div class="sw-level">
            <label>{{localize "STARWROUGHT.Field.level"}}</label>
            <input type="number" name="system.level" value="{{system.level}}" min="1" max="20" step="1">
          </div>
          <div class="sw-milestone" data-tooltip="STARWROUGHT.Field.milestoneHint">
            <label>{{localize "STARWROUGHT.Field.milestone"}}</label>
            <input type="number" name="system.milestone" value="{{system.milestone}}" min="0" max="3" step="1">
          </div>
          {{else}}
          <span class="sw-level-badge" data-tooltip="STARWROUGHT.Milestone.levelHint">
            {{localize "STARWROUGHT.Field.level"}} <strong>{{system.level}}</strong>
          </span>
          {{/if}}
        </div>
        <span class="sw-milestone-pips" data-tooltip="{{milestones.tooltip}}">
          {{#each milestones.pips as |pip|}}
          <i class="sw-milestone-pip {{#if pip.filled}}fa-solid sw-filled{{else}}fa-regular{{/if}} fa-star"></i>
          {{/each}}
        </span>
      </div>
    </div>

    {{!-- Identity (0.5.1, T8): set at creation, read by the player, typed only by the GM. --}}
    <div class="sw-identity">
      {{!-- A locked field's tooltip says what the name means: the chassis's description and its
            Root Talent (lockedTips in actor-sheet.mjs), rendered as HTML by Foundry's tooltip. --}}
      <label class="sw-field {{#unless isGM}}sw-locked{{/unless}}" {{#unless isGM}}data-tooltip="{{lockedTips.ancestry}}" data-tooltip-class="sw-tooltip-rich" data-tooltip-direction="DOWN"{{/unless}}>
        <span>{{localize "STARWROUGHT.Chassis.ancestry"}}</span>
        {{#if isGM}}<input type="text" name="system.details.ancestry.name" value="{{system.details.ancestry.name}}">
        {{else}}<strong class="sw-locked-value">{{system.details.ancestry.name}}</strong>{{/if}}
      </label>
      <label class="sw-field {{#unless isGM}}sw-locked{{/unless}}" {{#unless isGM}}data-tooltip="{{lockedTips.bloodline}}" data-tooltip-class="sw-tooltip-rich" data-tooltip-direction="DOWN"{{/unless}}>
        <span>{{localize "STARWROUGHT.Chassis.bloodline"}}</span>
        {{#if isGM}}<input type="text" name="system.details.bloodline.name" value="{{system.details.bloodline.name}}">
        {{else}}<strong class="sw-locked-value">{{system.details.bloodline.name}}</strong>{{/if}}
      </label>
      <label class="sw-field {{#unless isGM}}sw-locked{{/unless}}" {{#unless isGM}}data-tooltip="{{lockedTips.culture}}" data-tooltip-class="sw-tooltip-rich" data-tooltip-direction="DOWN"{{/unless}}>
        <span>{{localize "STARWROUGHT.Chassis.culture"}}</span>
        {{#if isGM}}<input type="text" name="system.details.culture.name" value="{{system.details.culture.name}}">
        {{else}}<strong class="sw-locked-value">{{system.details.culture.name}}</strong>{{/if}}
      </label>
      <label class="sw-field {{#unless isGM}}sw-locked{{/unless}}" {{#unless isGM}}data-tooltip="{{lockedTips.background}}" data-tooltip-class="sw-tooltip-rich" data-tooltip-direction="DOWN"{{/unless}}>
        <span>{{localize "STARWROUGHT.Chassis.background"}}</span>
        {{#if isGM}}<input type="text" name="system.details.background.name" value="{{system.details.background.name}}">
        {{else}}<strong class="sw-locked-value">{{system.details.background.name}}</strong>{{/if}}
      </label>
      <label class="sw-field {{#unless isGM}}sw-locked{{/unless}}" {{#unless isGM}}data-tooltip="{{lockedTips.calling}}" data-tooltip-class="sw-tooltip-rich" data-tooltip-direction="DOWN"{{/unless}}>
        <span>{{localize "STARWROUGHT.Chassis.calling"}}</span>
        {{#if isGM}}<input type="text" name="system.details.calling.name" value="{{system.details.calling.name}}">
        {{else}}<strong class="sw-locked-value">{{system.details.calling.name}}</strong>{{/if}}
      </label>
    </div>

    <div class="sw-vitals">

      {{!-- Vigor is what you have left in you, not meat. At 0 you are Spent: still standing, and
            every Hit now Wounds. --}}
      <div class="sw-vigor {{#if spent}}sw-spent{{/if}}">
        <div class="sw-vigor-track">
          <div class="sw-vigor-fill" style="width: {{vigor.pct}}%"></div>
          {{#if vigor.tempPct}}<div class="sw-vigor-temp" style="left: {{vigor.pct}}%; width: {{vigor.tempPct}}%"></div>{{/if}}
          <span class="sw-vigor-text">
            <span class="sw-vigor-name">{{localize "STARWROUGHT.Field.vigor"}}</span>
            <input type="number" name="system.vigor.value" value="{{vigor.value}}" min="0">
            <em>/ {{vigor.max}}</em>
            {{#if spent}}
            <span class="sw-spent-badge" data-tooltip="{{localize 'STARWROUGHT.Field.spentHint'}}">{{localize "STARWROUGHT.Condition.spent"}}</span>
            {{/if}}
          </span>
        </div>
        <div class="sw-vigor-meta">
          <label data-tooltip="STARWROUGHT.Field.tempHint">
            {{localize "STARWROUGHT.Field.temp"}}
            <input type="number" name="system.vigor.temp" value="{{vigor.temp}}" min="0">
          </label>
          <span class="sw-hint">{{localize "STARWROUGHT.Field.vigorPerLevel"}} {{vigor.perLevel}}</span>
        </div>
      </div>

      {{!-- How the next Blow is answered. The defender's call, so it is one click, always visible. --}}
      {{> "systems/starwrought/templates/actor/stance-chips.hbs" stance}}

      {{#if actions.show}}
      {{> "systems/starwrought/templates/actor/action-pips.hbs" actions}}
      {{/if}}

      <div class="sw-counters">
        {{!-- Hero Points (0.5.1, T9): the GM awards them with the stepper; a player has one button,
              Spend, and every press is a public card. Refuse Death takes them all by its own path. --}}
        <div class="sw-counter sw-hero-counter" data-tooltip="{{#if isGM}}STARWROUGHT.Field.heroPointsHint{{else}}STARWROUGHT.HeroPoints.playerHint{{/if}}">
          <span class="sw-counter-label">{{localize "STARWROUGHT.Field.heroPoints"}}</span>
          {{#if isGM}}
          <div class="sw-stepper">
            <a data-action="adjust" data-path="system.heroPoints.value" data-delta="-1">−</a>
            <strong>{{system.heroPoints.value}}</strong>
            <a data-action="adjust" data-path="system.heroPoints.value" data-delta="1">+</a>
          </div>
          {{else}}
          <div class="sw-stepper sw-hero-spend-row">
            <strong>{{system.heroPoints.value}}</strong>
            <button type="button" class="sw-hero-spend" data-action="spendHeroPoint"
                    {{#unless system.heroPoints.value}}disabled{{/unless}}>
              <i class="fa-solid fa-star"></i> {{localize "STARWROUGHT.HeroPoints.spend"}}
            </button>
          </div>
          {{/if}}
        </div>
        <div class="sw-counter {{#if woundCount}}sw-alert{{/if}}" data-tooltip="STARWROUGHT.Field.woundCountHint">
          <span class="sw-counter-label">{{localize "STARWROUGHT.Field.wounds"}}</span>
          <div class="sw-stepper"><strong>{{woundCount}}</strong></div>
        </div>
        <div class="sw-counter {{#if system.dying}}sw-danger{{/if}}" data-tooltip="STARWROUGHT.Field.dyingHint">
          <span class="sw-counter-label">{{localize "STARWROUGHT.Field.dying"}}</span>
          <div class="sw-stepper">
            <a data-action="adjust" data-path="system.dying" data-delta="-1">−</a>
            <strong>{{system.dying}}<em>/{{dyingMax}}</em></strong>
            <a data-action="adjust" data-path="system.dying" data-delta="1">+</a>
          </div>
        </div>
      </div>

    </div>

    {{#if bind}}
    {{> "systems/starwrought/templates/actor/bind-line.hbs" bind}}
    {{/if}}
  </div>
</header>
