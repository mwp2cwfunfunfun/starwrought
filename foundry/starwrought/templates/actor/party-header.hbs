{{!-- The party header (0.7.0): the portrait, the name, the session, and the GM's console. Every
      player can open the sheet (Observer), so the controls branch on isGM; the inputs are disabled
      for a player by the sheet itself. --}}
<header class="sw-header sw-party-header">

  <img class="sw-portrait" src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage"
       data-tooltip="STARWROUGHT.Sheet.editImage">

  <div class="sw-header-body">

    <div class="sw-name-row">
      <input class="sw-charname" type="text" name="name" value="{{actor.name}}"
             placeholder="{{localize 'STARWROUGHT.Party.namePlaceholder'}}">
      <span class="sw-level-badge sw-session-badge"
            data-tooltip="{{#if session.began}}{{localize 'STARWROUGHT.Party.sessionBeganHint' when=session.began}}{{else}}{{localize 'STARWROUGHT.Party.sessionHint'}}{{/if}}">
        {{localize "STARWROUGHT.Party.session"}} <strong>{{session.number}}</strong>
      </span>
    </div>

    <p class="sw-note sw-party-blurb">{{localize "STARWROUGHT.Party.blurb"}}</p>

    {{#if isGM}}
    <div class="sw-button-row sw-party-controls">
      <button type="button" data-action="beginSession" data-tooltip="{{localize 'STARWROUGHT.Party.beginSessionHint'}}">
        <i class="fa-solid fa-play"></i> {{localize "STARWROUGHT.Party.beginSession"}}
      </button>
      <button type="button" data-action="awardMilestone" data-tooltip="{{localize 'STARWROUGHT.Party.awardMilestoneHint'}}"
              {{#unless rows.length}}disabled{{/unless}}>
        <i class="fa-solid fa-star"></i> {{localize "STARWROUGHT.Party.awardMilestone"}}
      </button>
      {{#if lastAward}}
      <button type="button" data-action="takeBack" data-tooltip="{{lastAward.tooltip}}">
        <i class="fa-solid fa-rotate-left"></i> {{localize "STARWROUGHT.Party.takeBack"}}
      </button>
      {{/if}}
      <button type="button" data-action="partyRests" data-tooltip="{{localize 'STARWROUGHT.Party.restsHint'}}"
              {{#unless rows.length}}disabled{{/unless}}>
        <i class="fa-solid fa-bed"></i> {{localize "STARWROUGHT.Party.rests"}}
      </button>
      <button type="button" class="sw-inline-button sw-party-add-players" data-action="addPlayerCharacters"
              data-tooltip="{{localize 'STARWROUGHT.Party.addPlayersHint'}}">
        <i class="fa-solid fa-users"></i> {{localize "STARWROUGHT.Party.addPlayers"}}
      </button>
    </div>
    <p class="sw-note sw-party-drop"><i class="fa-solid fa-hand-pointer"></i> {{localize "STARWROUGHT.Party.dropHint"}}</p>
    {{/if}}

  </div>
</header>
