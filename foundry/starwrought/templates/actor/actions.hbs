{{!-- Maneuvers: what every character can do, then what this one has picked up. The tab keeps the
      id `actions` in code; the handbook calls them Maneuvers and every label here says so.

      0.28.0 (Mike: "only show Maneuvers that the system detects are applicable, but still allow
      the player to click a button to see all Maneuvers"; "Favorite maneuvers ... always at the top
      of the list and always visible"). By default the tab lists the Maneuvers that apply now; the
      toolbar's button lists every one, the rest dimmed with why. Favorites come first and are
      never left out. Every row is one partial, maneuver-row.hbs. Context: `maneuvers`, from
      SwCharacterSheet#prepareManeuvers. --}}
<section class="tab sw-tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">

  <div class="sw-tab-toolbar sw-maneuver-toolbar">
    {{#if maneuvers.hiddenNote}}<span class="sw-toolbar-note">{{maneuvers.hiddenNote}}</span>{{/if}}
    {{!-- Applicable only, or every Maneuver: a client setting, so it is this user's everywhere. --}}
    {{#if maneuvers.showAll}}
    <button type="button" class="sw-inline-button sw-active" data-action="toggleAllManeuvers"
            data-tooltip="{{localize 'STARWROUGHT.Maneuvers.applicableOnlyHint'}}">
      <i class="fa-solid fa-filter"></i> {{localize "STARWROUGHT.Maneuvers.applicableOnly"}}
    </button>
    {{else}}
    <button type="button" class="sw-inline-button" data-action="toggleAllManeuvers"
            data-tooltip="{{localize 'STARWROUGHT.Maneuvers.showAllHint'}}">
      <i class="fa-solid fa-eye"></i> {{localize "STARWROUGHT.Maneuvers.showAll"}}
    </button>
    {{/if}}
  </div>

  {{!-- FAVORITES (ruling 288): the Maneuvers the player bookmarked, from any panel below, first
        and never left out; one that does not apply now is dimmed and says why. --}}
  {{#if maneuvers.favorites.length}}
  <div class="sw-panel sw-favorite-actions">
    <h3 class="sw-panel-title"><span><i class="fa-solid fa-bookmark"></i> {{localize "STARWROUGHT.Maneuvers.favorites"}}</span></h3>
    <p class="sw-note">{{localize "STARWROUGHT.Maneuvers.favoritesHint"}}</p>
    <ol class="sw-item-list">
      {{#each maneuvers.favorites as |row|}}
      {{> "systems/starwrought/templates/actor/maneuver-row.hbs" row editable=@root.editable}}
      {{/each}}
    </ol>
  </div>
  {{/if}}

  {{!-- The Basic Maneuvers are read from the compendium, never copied onto the character, so a
        rewrite in data/maneuvers.xlsx reaches every sheet on the next build. --}}
  <div class="sw-panel sw-basic-actions">
    <h3 class="sw-panel-title">{{localize "STARWROUGHT.Section.basicActions"}}</h3>
    <p class="sw-note">{{localize "STARWROUGHT.Hint.basicActions"}}</p>
    {{#each maneuvers.basic.groups as |group|}}
    <div class="sw-action-group">
      <div class="sw-action-group-head">
        <a class="sw-collapse" data-action="toggleCollapse" data-slug="basic:{{group.key}}" data-part="actions">
          <i class="fa-solid {{#if group.collapsed}}fa-caret-right{{else}}fa-caret-down{{/if}}"></i>
        </a>
        <span class="sw-action-group-name">{{group.label}}</span>
        <span class="sw-points">{{group.actions.length}}</span>
      </div>
      {{#unless group.collapsed}}
      <ol class="sw-item-list">
        {{#each group.actions as |row|}}
        {{> "systems/starwrought/templates/actor/maneuver-row.hbs" row editable=@root.editable}}
        {{/each}}
      </ol>
      {{/unless}}
    </div>
    {{/each}}
    {{#if maneuvers.basic.empty}}<p class="sw-empty">{{maneuvers.basic.empty}}</p>{{/if}}
  </div>

  {{!-- TALENT MANEUVERS (0.16.0): the Maneuvers your Talents granted, each a row of
        data/maneuvers.xlsx copied onto the character with the Talent that granted it; used from
        here, and gone when the Talent goes. --}}
  {{#if maneuvers.talent.show}}
  <div class="sw-panel sw-talent-actions">
    <h3 class="sw-panel-title">{{localize "STARWROUGHT.Section.talentActions"}}</h3>
    <p class="sw-note">{{localize "STARWROUGHT.Hint.talentActions"}}</p>
    <ol class="sw-item-list">
      {{#each maneuvers.talent.rows as |row|}}
      {{> "systems/starwrought/templates/actor/maneuver-row.hbs" row editable=@root.editable}}
      {{/each}}
      {{#if maneuvers.talent.empty}}<li class="sw-empty">{{maneuvers.talent.empty}}</li>{{/if}}
    </ol>
  </div>
  {{/if}}

  <div class="sw-panel">
    <h3 class="sw-panel-title">
      {{localize "STARWROUGHT.Section.actions"}}
      <button type="button" class="sw-inline-button" data-action="itemCreate" data-type="action">
        <i class="fa-solid fa-plus"></i>
      </button>
    </h3>
    <p class="sw-note">{{localize "STARWROUGHT.Hint.actions"}}</p>
    <ol class="sw-item-list">
      {{#each maneuvers.own.rows as |row|}}
      {{> "systems/starwrought/templates/actor/maneuver-row.hbs" row editable=@root.editable}}
      {{/each}}
      {{#if maneuvers.own.empty}}<li class="sw-empty">{{maneuvers.own.empty}}</li>{{/if}}
    </ol>
  </div>

</section>
