{{!-- The adversary stat block: Defense Thresholds, one Attack Threshold per attack, Zones with their
      Protection and Wounds, and the Reactions it has. --}}
<section class="tab sw-tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">

  <div class="sw-panel">
    <h3 class="sw-panel-title">{{localize "STARWROUGHT.Section.thresholds"}}</h3>
    <p class="sw-note">{{localize "STARWROUGHT.Hint.npcThresholds"}}</p>
    <div class="sw-defense-grid">
      {{#each defenses as |def|}}
      <div class="sw-defense sw-npc-defense {{#if def.isStance}}sw-stance-active{{/if}}">
        {{#if def.isStance}}<span class="sw-stance-tag">{{localize "STARWROUGHT.Stance.tag"}}</span>{{/if}}
        <span class="sw-defense-name" data-tooltip="{{def.hint}}">{{def.label}}</span>
        <input type="number" name="system.thresholds.{{def.key}}" value="{{def.threshold}}">
      </div>
      {{/each}}
    </div>
  </div>

  <div class="sw-panel">
    <h3 class="sw-panel-title">
      {{localize "STARWROUGHT.Section.attacks"}}
      <button type="button" class="sw-inline-button" data-action="itemCreate" data-type="action" data-attack="true">
        <i class="fa-solid fa-plus"></i>
      </button>
    </h3>
    <table class="sw-attack-table">
      <thead>
        <tr>
          <th>{{localize "STARWROUGHT.Field.attack"}}</th>
          <th data-tooltip="STARWROUGHT.Hint.attackThreshold">{{localize "STARWROUGHT.Field.threshold"}}</th>
          <th>{{localize "STARWROUGHT.Field.damage"}}</th>
          <th>{{localize "STARWROUGHT.Field.reach"}}</th>
          <th></th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each attacks as |atk|}}
        <tr data-item-id="{{atk.id}}">
          <td><a data-action="itemChat">{{swPlainName atk.name}}</a></td>
          <td class="sw-num sw-threshold-cell">{{atk.threshold}}</td>
          <td>{{atk.damage}} {{atk.damageType}}</td>
          <td class="sw-num">{{atk.reach}} ft</td>
          <td class="sw-strike-cell">
            {{!-- Three Strikes, as on a weapon row: the adversary's Maneuver, declared against the
                 GM's current targets (0.5.0 brief, Entry points). The players roll Defense. The
                 glyph is the large gold one (0.5.1, T1). --}}
            <span class="sw-strike-buttons">
              <a class="sw-strike-button sw-strike-quick" data-action="attackWith" data-strike="quick"
                 data-tooltip="{{localize 'STARWROUGHT.Strike.quickHint'}}"><span class="sw-action-glyph">{{swStrikeGlyph "quick"}}</span> <span class="sw-strike-word">{{localize "STARWROUGHT.Strike.quick"}}</span></a>
              <a class="sw-strike-button sw-strike-deliberate" data-action="attackWith" data-strike="deliberate"
                 data-tooltip="{{localize 'STARWROUGHT.Strike.deliberateHint'}}"><span class="sw-action-glyph">{{swStrikeGlyph "deliberate"}}</span> <span class="sw-strike-word">{{localize "STARWROUGHT.Strike.deliberate"}}</span></a>
              <a class="sw-strike-button sw-strike-committed" data-action="attackWith" data-strike="committed"
                 data-tooltip="{{localize 'STARWROUGHT.Strike.committedHint'}}"><span class="sw-action-glyph">{{swStrikeGlyph "committed"}}</span> <span class="sw-strike-word">{{localize "STARWROUGHT.Strike.committed"}}</span></a>
            </span>
          </td>
          <td class="sw-item-controls">
            <a data-action="itemEdit"><i class="fa-solid fa-pen"></i></a>
            <a data-action="itemDelete"><i class="fa-solid fa-trash"></i></a>
          </td>
        </tr>
        {{else}}
        <tr><td colspan="6" class="sw-empty">{{localize "STARWROUGHT.Sheet.noAttacks"}}</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  <div class="sw-panel">
    <h3 class="sw-panel-title">
      {{localize "STARWROUGHT.Section.zones"}}
      <span class="sw-panel-buttons">
        <span class="sw-points" data-tooltip="STARWROUGHT.Field.woundCountHint">
          {{localize "STARWROUGHT.Field.wounds"}} {{woundCount}}
        </span>
        <button type="button" class="sw-inline-button" data-action="recenter"
                data-tooltip="STARWROUGHT.Action.recenterHint">{{swActionGlyph 1}} {{localize "STARWROUGHT.Action.recenter"}}</button>
      </span>
    </h3>
    <table class="sw-armor-table">
      <thead>
        <tr>
          <th>{{localize "STARWROUGHT.Field.zone"}}</th>
          <th>{{localize "STARWROUGHT.Field.protection"}}</th>
          <th>{{localize "STARWROUGHT.Field.material"}}</th>
          <th>{{localize "STARWROUGHT.Field.wounds"}}</th>
          <th>{{localize "STARWROUGHT.Condition.exposed"}}</th>
        </tr>
      </thead>
      <tbody>
        {{#each zones as |zone|}}
        <tr class="{{#if zone.exposed}}sw-row-exposed{{/if}} {{#if zone.wounds.wounded}}sw-row-wounded{{/if}}">
          <td class="sw-zone-cell">{{zone.label}}</td>
          <td><input type="number" name="system.zones.{{zone.key}}.protection" value="{{zone.protection}}" min="0"></td>
          <td><select name="system.zones.{{zone.key}}.material">{{selectOptions @root.materialChoices selected=zone.material}}</select></td>
          <td class="sw-wounds-cell">
            {{> "systems/starwrought/templates/actor/wounds.hbs" zone.wounds}}
          </td>
          <td>
            <a data-action="toggleZone" data-zone="{{zone.key}}">
              {{#if zone.exposed}}<i class="fa-solid fa-heart-crack"></i>{{else}}<i class="fa-solid fa-shield"></i>{{/if}}
            </a>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>

  {{#if reactions.any}}
  {{!-- "A creature's profile lists the Reactions it has." Skipped entirely when it has none. --}}
  <div class="sw-panel">
    <h3 class="sw-panel-title">{{localize "STARWROUGHT.Section.reactions"}}</h3>
    <div class="sw-chip-row">
      {{#each reactions.granted as |reaction|}}
      <span class="sw-trait sw-reaction-chip">{{reaction.glyph}} {{reaction.label}}</span>
      {{/each}}
    </div>
    {{#if reactions.abilities.length}}
    <ol class="sw-item-list">
      {{#each reactions.abilities as |ability|}}
      <li class="sw-item-row sw-action-row" data-item-id="{{ability.id}}">
        <img src="{{ability.img}}" alt="{{ability.name}}">
        <span class="sw-action-glyph">{{ability.glyph}}</span>
        <a class="sw-item-name" data-action="itemChat">{{swPlainName ability.name}}</a>
        <div class="sw-item-controls">
          <a data-action="itemEdit"><i class="fa-solid fa-pen"></i></a>
        </div>
      </li>
      {{/each}}
    </ol>
    {{/if}}
  </div>
  {{/if}}

  <div class="sw-panel">
    <h3 class="sw-panel-title">{{localize "STARWROUGHT.Section.traits"}}</h3>
    <div class="sw-body-grid">
      <label class="sw-field sw-wide"><span>{{localize "STARWROUGHT.Field.senses"}}</span>
        <input type="text" name="system.details.senses" value="{{system.details.senses}}"></label>
      <label class="sw-field sw-wide"><span>{{localize "STARWROUGHT.Field.languages"}}</span>
        <input type="text" name="system.details.languages" value="{{system.details.languages}}"></label>
      <label class="sw-field sw-wide"><span>{{localize "STARWROUGHT.Field.source"}}</span>
        <input type="text" name="system.details.source" value="{{system.details.source}}"></label>
    </div>
  </div>

</section>
