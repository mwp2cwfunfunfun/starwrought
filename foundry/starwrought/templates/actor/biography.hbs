{{!-- Who they were before the road, what they hold to and what they will not do (Biography, Edicts
      and Anathema since 0.17.0). The Notes have their own tab (notes.hbs). --}}
<section class="tab sw-tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">

  <div class="sw-panel">
    <h3 class="sw-panel-title">{{localize "STARWROUGHT.Section.biography"}}</h3>
    <prose-mirror name="system.details.biography" value="{{system.details.biography}}"
                  {{#unless editable}}disabled{{/unless}} toggled>
      {{{enrichedBiography}}}
    </prose-mirror>
  </div>

  <div class="sw-panel">
    <h3 class="sw-panel-title">{{localize "STARWROUGHT.Section.edicts"}}</h3>
    <prose-mirror name="system.details.edicts" value="{{system.details.edicts}}"
                  {{#unless editable}}disabled{{/unless}} toggled>
      {{{enrichedEdicts}}}
    </prose-mirror>
  </div>

  <div class="sw-panel">
    <h3 class="sw-panel-title">{{localize "STARWROUGHT.Section.anathema"}}</h3>
    <prose-mirror name="system.details.anathema" value="{{system.details.anathema}}"
                  {{#unless editable}}disabled{{/unless}} toggled>
      {{{enrichedAnathema}}}
    </prose-mirror>
  </div>

</section>
